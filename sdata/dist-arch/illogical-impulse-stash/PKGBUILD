groups=(illogical-impulse)
pkgname=illogical-impulse-stash
_pkgname=stash
pkgver=0.5.2
pkgrel=1
pkgdesc='Stash clipboard manager for illogical-impulse dotfiles.'
arch=("x86_64" "aarch64")
url="https://github.com/NotAShelf/${_pkgname}"
license=('MPL-2.0')
depends=(
  gcc-libs
  glibc
  wayland
)
makedepends=("git" "rust")
provides=("stash")
conflicts=("stash")
source=("git+${url}.git#tag=v${pkgver}")
sha256sums=("SKIP")

build() {
  cd $_pkgname
  cargo build --release --locked
}

package() {
  cd $_pkgname
  install -Dm0755 -t "$pkgdir/usr/bin/" target/release/stash
  install -Dm0644 -t "$pkgdir/usr/share/licenses/$pkgname/" LICENSE
}
