[Unit]
Description=Quickshell
PartOf=graphical-session.target
After=graphical-session.target
StartLimitIntervalSec=300
StartLimitBurst=20

[Service]
Type=simple
ExecStart=/usr/bin/qs -c ii
Restart=always
RestartSec=2
Slice=session.slice

# A shell that runs away with memory takes the whole session down with it, so it is
# held to a ceiling it has no business reaching and restarted when it does. A ceiling
# rather than MemoryHigh: throttling a shell that is merely churning buffers would make
# the desktop stutter instead.
MemoryMax=8G

[Install]
WantedBy=hyprland-session.target
