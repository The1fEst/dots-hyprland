[Unit]
Description=Quickshell
PartOf=graphical-session.target
After=graphical-session.target
StartLimitIntervalSec=300
StartLimitBurst=20

[Service]
Type=simple
ExecStart=/usr/bin/qs -c ii
Restart=always
RestartSec=2
Slice=session.slice

# Apps are launched into scopes of their own, but anything that still ends up here
# is a guest: stopping the shell must not take it down.
KillMode=process

[Install]
WantedBy=hyprland-session.target
