[Unit]
Description=Clipboard history for text
PartOf=graphical-session.target
After=graphical-session.target
StartLimitIntervalSec=300
StartLimitBurst=20

[Service]
Type=simple
ExecStart=/usr/bin/wl-paste --type text --watch /usr/bin/bash -c 'cliphist store && qs -c ii ipc call cliphistService update'
Restart=always
RestartSec=2
Slice=session.slice

[Install]
WantedBy=hyprland-session.target
